{
  "name": "@ai-coding-site/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "cli": "tsx src/cli/index.ts",
    "test": "rm -rf .tmp/test-data .tmp/test-repos && mkdir -p .tmp/test-data .tmp/test-repos && AI_CODING_DATA_ROOT=.tmp/test-data AI_CODING_REPOS_ROOT=.tmp/test-repos tsx --test src/integration.test.ts src/services/orchestration/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "nanoid": "^5.1.5",
    "ws": "^8.19.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
